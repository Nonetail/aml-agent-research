  {
    "name": "verify_path",
    "description": "Check connectivity/time/optional closure, not laundering or conservation of funds.",
    "parameters": {
      "type": "object",
      "properties": {
        "transaction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Source SHA256:original row ordinal"
          },
          "minItems": 2,
          "maxItems": 100
        },
        "strict": {
          "type": "boolean",
          "default": true
        },
        "cycle": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "transaction_ids"
