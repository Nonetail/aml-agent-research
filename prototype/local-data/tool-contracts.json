              "start": {
                "type": "string",
                "description": "Inclusive source time YYYY/MM/DD HH:MM"
              },
              "end": {
                "type": "string",
                "description": "Exclusive source time YYYY/MM/DD HH:MM"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "incoming",
                  "outgoing"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500,
